# Copy to .env and fill in. The notebook loads this automatically.

OPENAI_API_KEY=your-key-here

# Optional: web search for the market-researcher subagent.
# LinkUp is tried first (primary); Tavily is used as a fallback if LinkUp is
# not set or fails to initialize. Omit both to run grounding-only.
LINKUP_API_KEY=your-key-here
TAVILY_API_KEY=your-key-here

# Optional: LangSmith tracing (great for showing the agent's steps in a UI)
# LANGSMITH_API_KEY=your-key-here
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=career-trajectory-optimizer

# Optional: override the model used by both the notebook and the Streamlit UI.
# Recommended: a free-daily-quota model (see platform.openai.com/docs/models):
#   gpt-5-mini / gpt-5-nano / gpt-4.1-mini / gpt-4.1-nano / gpt-4o-mini — 2.5M tokens/day
#   gpt-5.1 / gpt-4.1 / gpt-4o — 250K tokens/day
# CAREER_AGENT_MODEL=gpt-5-mini

